# Copy to .env.local. Use values from `npx supabase status` for local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only used by database integration tests, never by the browser or app runtime.
# Tests refuse non-loopback database hosts and roll back their fixtures.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Only used to create and delete isolated LOCAL browser-test users.
SUPABASE_TEST_SERVICE_ROLE_KEY=
