# Copy to .env.local. Use values from `npx supabase status` for local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to development on the hosted dev project to label the preview and sign-up behavior.
NEXT_PUBLIC_DEPLOYMENT_STAGE=

# Only used by database integration tests, never by the browser or app runtime.
# Tests refuse non-loopback database hosts and roll back their fixtures.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Only used to create and delete isolated LOCAL browser-test users.
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Server-only trusted AI accounting, diagnostic evaluation and milestone proposals.
# Manual course entry, diagnostics and proposal APIs work without OpenAI settings.
# Use a project-scoped Supabase secret/service-role key; never a NEXT_PUBLIC variable.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=
# For models supporting it, use none for bounded, low-latency extraction.
OPENAI_EXTRACTION_REASONING_EFFORT=
# Shared rolling 24-hour request limit across all accounts; range 1–100.
OPENAI_EXTRACTION_DAILY_LIMIT=50
